# Free Groq key: https://console.groq.com/keys  (set in Vercel → Settings → Environment Variables)
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-120b
GROQ_MODEL=
# Optional: fine-grained GitHub token with no permissions, only raises Sonar's GitHub search rate limit
GITHUB_TOKEN=
# Optional Orpheus voice for Byte (accept the model's terms once in the Groq console first); falls back to the browser voice
GROQ_VOICE=
